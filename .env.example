# MQTT_BROKER / MQTT_USER / MQTT_PASS are required: the process exits with
# code 2 when any of them is empty. There are no built-in defaults.
LOG_LEVEL=info
MQTT_BROKER=
MQTT_CLIENT_ID=
MQTT_USER=
MQTT_PASS=

# Servo angle used for "open", in the actuator's range (0-135 with the library
# defaults), not in degrees of barrier travel. 90 is two thirds of the sweep.
GATE_OPEN_ANGLE=90
